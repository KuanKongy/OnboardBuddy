# Frontend configuration.
#
# `npm run dev` / `vite preview` read this file at build time (Vite inlines
# VITE_* into the bundle). The Docker image does NOT: docker-compose.yml passes
# this same file to the frontend container as env_file and the container reads
# it at startup, so one image can serve any API origin (doc/DEVOPS.md →
# "Runtime configuration"). Change a value, then `docker compose up -d
# frontend` — no rebuild.
#
# All three are public by design; they ship to every browser that loads the
# app. Never put a secret here. The anon key is the RLS-gated publishable key,
# not the service-role key.

# Backend API base URL, including the /api prefix. Use the origin the BROWSER
# reaches, not a container name. May also be a same-origin path (/api) if the
# API is served from the same host.
VITE_API_URL=http://localhost:3000/api

# Supabase project URL, e.g. https://abcdefgh.supabase.co (no trailing path).
VITE_SUPABASE_URL=

# Supabase publishable (anon) key.
VITE_SUPABASE_ANON_KEY=
