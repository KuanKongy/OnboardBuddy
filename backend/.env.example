NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Supabase (Settings > Data API for URL, Settings > API Keys for keys)
# URL must be the project root, e.g. https://<ref>.supabase.co — NOT /rest/v1
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Database (Settings > Database > Connection string URI, Session mode)
DATABASE_URL=

# Upstash Redis (TCP/TLS endpoint, NOT the HTTP/REST one)
REDIS_URL=
# BullMQ drainDelay when queue is empty (ms). Higher = fewer idle Redis commands = lower Upstash cost.
WORKER_POLL_INTERVAL_MS=30000

# GitHub OAuth App (for Supabase Auth login)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App (for read-only repo import)
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_PATH=./github-app.pem
# Used to sign GitHub App install state. Defaults to TOKEN_ENCRYPTION_KEY if omitted.
GITHUB_INSTALL_STATE_SECRET=

# OpenRouter (AI explanation layer)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model tiers (doc/Pipeline.md "Model tiers and failure behavior"):
# cheap = symbol-level semantic pass, strong = synthesis/sections/tutorials.
# Legacy OPENROUTER_MODEL is still honored as the cheap-tier default.
OPENROUTER_MODEL_CHEAP=openai/gpt-4o-mini
# Both tiers default to gpt-4o-mini (cents per analysis). Uncomment to use a
# premium model for synthesis/sections — roughly 20x the price:
# OPENROUTER_MODEL_STRONG=anthropic/claude-sonnet-4.5
# Max concurrent LLM requests per worker process.
LLM_MAX_CONCURRENCY=4

# Embeddings (for RAG — uses OpenAI directly, not OpenRouter)
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=https://api.openai.com/v1
EMBEDDINGS_MODEL=text-embedding-3-small

# Encryption key for GitHub tokens (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
TOKEN_ENCRYPTION_KEY=
