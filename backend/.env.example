NODE_ENV=development
PORT=3000
# Browser origin(s) allowed to call this API; comma-separated for more than
# one. REQUIRED when NODE_ENV=production — the API refuses to start without it
# rather than falling back to localhost, which would block the deployed
# frontend while allowing a local page to call production (bug #15).
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Supabase (Settings > Data API for URL, Settings > API Keys for keys)
# URL must be the project root, e.g. https://<ref>.supabase.co — NOT /rest/v1
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Database (Connect button at the top of the dashboard > Transaction pooler, :6543)
DATABASE_URL=
# Session-mode URL (same page, Session mode, port 5432) — DDL/migrations only
# (psql -f 001_initial_schema.sql and manual ALTERs). App code never reads this.
DIRECT_DATABASE_URL=
# Per-process pg pool cap (code default 30; see backend/src/lib/db.ts for the
# arithmetic). DATABASE_URL points at the TRANSACTION-mode pooler (connections
# are borrowed per statement and multiplexed), so this sizes for the process's
# own concurrent-statement fan-out, not a shared session budget.
# Recommended: 10 for the API process, 30 for the worker — the worker hosts BOTH
# the analysis and package-generation workers in one process, so its pool serves
# WORKER_CONCURRENCY + SUMMARY_CONCURRENCY jobs at once (~6 connections each).
# docker-compose.yml pins both services; a compose `environment:` entry
# OVERRIDES this file, so change it there too if you change it here.
# Ceiling: Supavisor allows ~200 client connections per project but only
# ~15-20 real backends (default_pool_size) — going far past 2x that just moves
# the queue to the pooler. Raise default_pool_size in Supabase first.
# DDL/migrations must use DIRECT_DATABASE_URL (session mode, :5432) instead.
PG_POOL_MAX=30

# Upstash Redis (TCP/TLS endpoint, NOT the HTTP/REST one).
# REDIS_HOST / REDIS_PORT / REDIS_PASSWORD are accepted as an alternative if you
# have the parts rather than a URL; REDIS_URL wins when both are present.
REDIS_URL=
# How long an idle worker blocks between wake-ups, in SECONDS (BullMQ's actual
# drainDelay unit; default 300, floor 30). Bounds how fast BullMQ replaces a
# silently dead blocking socket; job pickup is instant regardless (enqueue
# interrupts the block). Lower = faster socket healing but more idle Upstash
# commands. Replaces WORKER_POLL_INTERVAL_MS, which is now ignored with a
# boot-time warning.
WORKER_IDLE_BLOCK_SECONDS=300

# RETIRED — safe to leave unset. Login runs through the GitHub App's own OAuth
# now, and the only place those credentials are read is the Supabase dashboard
# (Authentication > Providers > GitHub), which holds them itself. Nothing in
# this codebase reads GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET; kept named here
# so an older .env copied forward is recognisable rather than mysterious.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# GitHub App (for read-only repo import)
GITHUB_APP_ID=
# Optional: HMAC secret for the App push webhook (auto re-analysis). Unset = webhook off.
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_PATH=./github-app.pem
# Alternative to the path, for hosts without file mounts (e.g. Railway): the full
# PEM *contents*. Takes precedence over the path; \n-escaped newlines are fine.
# GITHUB_APP_PRIVATE_KEY=
# Used to sign GitHub App install state. Defaults to TOKEN_ENCRYPTION_KEY if omitted.
GITHUB_INSTALL_STATE_SECRET=

# OpenRouter (AI explanation layer)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model tiers (doc/Pipeline.md "Model tiers and failure behavior"):
# cheap = symbol-level semantic pass, strong = synthesis/sections/tutorials.
# Both tiers default to DeepSeek V4 Flash (1M context, 65k max output,
# $0.09/M in / $0.18/M out — cents per analysis). Point strong at a premium
# model if section prose quality matters more than cost.
OPENROUTER_MODEL_CHEAP=google/gemini-2.5-flash-lite
OPENROUTER_MODEL_STRONG=google/gemini-2.5-flash-lite
# Max concurrent LLM requests per AiClient — one client PER RUNNING JOB, so this
# is NOT a global cap: N concurrent runs burst up to N x this at OpenRouter, and
# OpenRouter's rate/spend limits are per key. Lower it if you raise
# WORKER_CONCURRENCY on a tight key.
LLM_MAX_CONCURRENCY=28
# Per-replica worker knobs (doc/DEVOPS.md "Scaling workers"). Code defaults shown;
# docker-compose.yml pins the first two for the backend-worker service.
# WORKER_CONCURRENCY=4      # parallel analysis runs per worker process
# SUMMARY_CONCURRENCY=4     # parallel package generations per worker process
#                           # (own knob since 2026-07-25 — it used to read
#                           #  WORKER_CONCURRENCY, so one number moved both)
# SECTION_CONCURRENCY=12    # sections generated in parallel WITHIN one package job
# Raising these raises pg pool demand: budget ~6 connections per concurrent job
# and keep PG_POOL_MAX above (WORKER_CONCURRENCY + SUMMARY_CONCURRENCY) x 6.
# Restart resilience (src/worker/jobRecovery.ts, src/worker/shutdown.ts).
# WORKER_SHUTDOWN_GRACE_MS=25000  # on SIGTERM: stop taking jobs, finish the
#                           #  current ones, then exit. Must stay UNDER the
#                           #  orchestrator's stop grace (docker-compose.yml
#                           #  stop_grace_period: 30s) or the drain is SIGKILLed.
# JOB_RECOVERY_MAX_ATTEMPTS=2 # times one job row may be auto re-queued after a
#                           #  worker restart before it is declared genuinely
#                           #  broken. The count is durable, in
#                           #  analysis_jobs.checkpoint->recovery->attempts,
#                           #  which is what stops a crash-on-sight repo from
#                           #  looping and burning LLM budget.
# Rate-limit auto-resume (src/worker/rateLimitResume.ts): a run the provider
# 429'd for longer than the in-process gate can wait out re-queues ITSELF
# instead of parking on 'paused' for a human. Also durable-counted, in
# analysis_jobs.checkpoint->rateLimitResumes.
# RATE_LIMIT_RESUME_MAX=3     # auto-resumes per job row before the pause stands
# RATE_LIMIT_RESUME_DELAY_MS=300000 # wait before the re-queued job runs

# Embeddings (for RAG). Routing is keyed on the model id's SHAPE
# (worker/ai/embeddingProfiles.ts):
#   - slash form ("vendor/model", e.g. perplexity/pplx-embed-v1-4b) goes via
#     OpenRouter with OPENROUTER_API_KEY and the same ZDR provider prefs as
#     chat; vectors longer than 1536 dims are MRL-truncated + L2-normalized
#     to fit the frozen vector(1536) column.
#   - bare form (e.g. text-embedding-3-small) uses the OpenAI-direct pair
#     below with `dimensions: 1536`.
# The OpenAI-direct pair is OPTIONAL (2026-08-16 decision: everything routes
# via OpenRouter). Retrieval detects which model wrote each snapshot's vectors
# and embeds queries with THAT model, so leave these set only if you still
# need /ask against ancient snapshots embedded with the bare OpenAI id.
# EMBEDDINGS_API_KEY=
# EMBEDDINGS_BASE_URL=https://api.openai.com/v1
# qwen3-embedding-8b (2026-08-16): best MTEB of the options tried; 4096-dim
# MRL vectors truncate cleanly to 1536; routes to SiliconFlow under zdr+deny;
# measured 2,706 vectors in 113s. History: pplx-embed abandoned same day
# (throttled for minutes at a stretch + the count ceiling below).
EMBEDDINGS_MODEL=qwen/qwen3-embedding-8b
# Inputs per embeddings API request (default 128). Measured 2026-08-16:
# pplx-embed via OpenRouter refuses any single request over ~100-160 inputs as
# a 429 that no amount of waiting clears (64 passed even with long content;
# 128/256 were refused every time across a 40-minute storm) — the limit is on
# input COUNT per request, not tokens. Run 64 against that upstream.
# EMBED_BATCH_SIZE=128
# Embedding requests in flight at once (default 3). pplx-embed rides a single
# ZDR upstream whose rate limits are per key — 8 large batches at once drew the
# 429s that paused runs. During a sustained storm, 1 (serialized) rides best:
# each request then faces the upstream's full refilled allowance alone.
# EMBED_REQUEST_CONCURRENCY=3
# Embedding write-path tuning (semantic/embeddingPass.ts). Concurrent INSERT
# writers per analysis job (default 2 — the measured 8-way self-contention
# collapse is why this is small) and rows per INSERT statement (default 64).
# EMBED_WRITE_CONCURRENCY=2
# EMBED_INSERT_CHUNK=64
# Max hedged duplicate LLM calls per analysis run for symbol-phase straggler
# batches (default 3; winner-take-first, loser aborted — see symbolPass.ts).
# SYMBOL_HEDGE_MAX=3

# Encryption key for GitHub tokens (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
TOKEN_ENCRYPTION_KEY=

# BullMQ queue-name suffix. Leave EMPTY for local work unless you need to
# isolate yourself: shared cloud Redis means a teammate's running worker can
# steal your jobs, and a suffix (e.g. "-alice") gives your producers and
# consumers private queues.
# The api and worker processes MUST be given the same value — each resolves its
# queue names from its own environment, so a mismatch enqueues into a queue
# nobody consumes and the job sits in 'waiting' with no error anywhere.
# In production use "-prod", so a deployed worker and the shared dev Redis
# cannot end up on the same queue names.
QUEUE_SUFFIX=
# Per-attempt LLM request deadline in ms (default 240000); slow-upstream calls
# are aborted and retried instead of running 10+ minutes.
# LLM_REQUEST_TIMEOUT_MS=240000
# OpenRouter upstream routing preference (default "throughput"; "" disables).
# OPENROUTER_PROVIDER_SORT=throughput
# Privacy filters for provider routing (defaults shown): zdr=true restricts
# routing to Zero-Data-Retention endpoints only; data_collection='deny'
# additionally excludes providers that collect/train on prompts.
# Set OPENROUTER_ZDR=false / OPENROUTER_DATA_COLLECTION="" to loosen.
# OPENROUTER_ZDR=true
# OPENROUTER_DATA_COLLECTION=deny
# Absolute path to `unzip` for repo-zip extraction (worker/index.ts). Default
# is the bare command "unzip", which the worker's alpine/BusyBox Docker image
# resolves on PATH — leave unset there. Native (non-Docker) Windows dev only:
# `execFile`'s PATH resolution for a bare command name isn't reliable through
# every npm/tsx-watch process hop, so point this at a real unzip.exe (Git for
# Windows ships one) if you hit `spawn unzip ENOENT`.
# UNZIP_BIN=C:/Program Files/Git/usr/bin/unzip.exe
