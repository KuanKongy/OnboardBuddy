FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json* ./
COPY backend/package.json backend/package.json
RUN npm install --workspaces --include-workspace-root

FROM node:22-alpine AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY package.json tsconfig.base.json ./
COPY backend ./backend
RUN npm run build -w backend

FROM node:22-alpine AS worker
WORKDIR /app
ENV NODE_ENV=production
COPY package.json ./
COPY backend/package.json backend/package.json
COPY --from=deps /app/node_modules ./node_modules
COPY --from=build /app/backend/dist ./backend/dist
# Run node DIRECTLY, not via `npm run` — graceful shutdown depends on it.
# `npm run` becomes PID 1 and node a grandchild; npm's signal forwarding to
# the script child is unreliable, and the kernel drops default-action signals
# to PID 1 entirely. Either way SIGTERM never reached the worker's handler, so
# every deploy killed in-flight runs outright instead of draining them
# (src/worker/shutdown.ts). WORKDIR must be backend/ because the process
# resolves GITHUB_APP_PRIVATE_KEY_PATH="./github-app.pem" relative to cwd —
# `npm run -w backend` used to set that; node_modules still resolves upward
# to the hoisted /app/node_modules.
WORKDIR /app/backend
CMD ["node", "dist/worker/index.js"]
